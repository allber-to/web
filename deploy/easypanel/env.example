# EasyPanel backend Compose environment. Generate NEW secrets; never use local-backend/.env.
# Leave ports/origins empty until the operator confirms availability on the VPS.
API_PORT=
APP_URL=
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
IN_USER_EMAIL=
IN_PASSWORD=

# Fixed in compose.yml, not configurable through this editor:
# NINJA_ENVIRONMENT=selfhost
# APP_ENV=production
# APP_DEBUG=false
# REQUIRE_HTTPS=false
# IS_DOCKER=true
# PDF_GENERATOR=snappdf
# PHANTOMJS_PDF_GENERATION=false
# FILESYSTEM_DISK=debian_docker
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=redis
# DB_HOST=mysql
# DB_CONNECTION=mysql
# DB_DATABASE=ninja
# DB_USERNAME=ninja
# MAIL_MAILER=log
# MAIL_HOST=
# SCOUT_DRIVER=null
# TRUSTED_PROXIES, API_SECRET and third-party credentials are deliberately absent.
