# EasyPanel backend Compose environment. Generate NEW secrets; never use local-backend/.env.
# Set APP_URL=https://<confirmed API hostname>, without a trailing slash.
# No host ports are published; EasyPanel routes the API domain to nginx:80.
APP_URL=

# Default is * while nginx is reachable only through Docker networks.
# Restrict to the verified proxy range when known; never publish a direct port with *.
TRUSTED_PROXIES=*
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
IN_USER_EMAIL=
IN_PASSWORD=

# Fixed in compose.yml, not configurable through this editor:
# NINJA_ENVIRONMENT=selfhost
# APP_ENV=production
# APP_DEBUG=false
# SENTRY_LARAVEL_DSN=
# DISABLE_AUTO_UPDATE=true
# REQUIRE_HTTPS=true
# IS_DOCKER=true
# PDF_GENERATOR=snappdf
# PHANTOMJS_PDF_GENERATION=false
# FILESYSTEM_DISK=debian_docker
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=redis
# DB_HOST=mysql
# DB_CONNECTION=mysql
# DB_DATABASE=ninja
# DB_USERNAME=ninja
# MAIL_MAILER=log
# MAIL_HOST=
# SCOUT_DRIVER=null
# API_SECRET and third-party credentials are deliberately absent.

# The app has unrestricted outbound internet on its own egress network.
# MySQL/Redis remain on the internal backend network only; no host ports.
# MAIL_MAILER=log prevents actual email by configuration, not by network isolation.
